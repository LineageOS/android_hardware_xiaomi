cc_binary {
    name: "ble-remote-scanner",
    init_rc: ["ble-remote-scanner.rc"],
    recovery: true,
    srcs: [
        "main.cpp",
        "remote_hci.cpp",
        "remote_input.cpp",
        "transport_bcm.cpp",
        "transport_mtk.cpp",
    ],
    cppflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
    ],
}
