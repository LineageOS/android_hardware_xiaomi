<!-- 16:9 launcher banner: the icon artwork on a wide background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2933" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_remote" android:gravity="center"
        android:width="140dp" android:height="140dp" />
</layer-list>
