allow hal_audio_default vendor_persist_audio_file:file rw_file_perms;
allow hal_audio_default smartpa_type:file r_file_perms;
allow hal_audio_default mnt_vendor_file:dir search;

dontaudit hal_audio_default sysfs:dir read;

unix_socket_connect(hal_audio_default, audio, hal_sensors_default)

get_prop(hal_audio_default, elliptic_ultrasound_prop)
set_prop(hal_audio_default, vendor_audio_prop)
