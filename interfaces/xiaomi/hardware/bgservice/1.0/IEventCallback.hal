package vendor.xiaomi.hardware.bgservice@1.0;

interface IEventCallback {
    notifyCallback(CallbackData callbackData) generates (bool result);
    notifySnapshotAvailability(int32_t i) generates (bool result);
    onCaptureCompleted(string str, int32_t i) generates (bool result);
    onCaptureFailed(string str, int32_t i) generates (bool result);
};
